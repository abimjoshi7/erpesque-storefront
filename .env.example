# Where the ERP API lives.
#   local development  http://127.0.0.1:3000
#   production         https://api.ghumtibags.com   (the Cloudflare Worker)
ERP_API_URL=http://127.0.0.1:3000

# Exactly one of the following. Neither is NEXT_PUBLIC_: these are read only in
# server components and route handlers, so they never reach a browser bundle.
#
# Talking to the Worker (production) — its edge gate expects this header:
# ERP_CLIENT_API_KEY=

# Talking to the Rust origin directly (local development, no Worker in front) —
# same value as the server's API_KEY:
ERP_ORIGIN_API_KEY=
