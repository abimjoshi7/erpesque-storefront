# --- OrderDesk own datastores -------------------------------------------------
DATABASE_URL="postgresql://orderdesk:orderdesk@localhost:5433/orderdesk?schema=public"
REDIS_URL="redis://localhost:6380"

# --- Auth ---------------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- Erpesque (Rust ERP) integration -----------------------------------------
# Local Rust API: http://127.0.0.1:3000
# Worker proxy:   https://erpesque.abimjoshi7.workers.dev
ERP_BASE_URL="http://127.0.0.1:3000"
ERP_SERVICE_USERNAME=""
ERP_SERVICE_PASSWORD=""
ERP_CLIENT_API_KEY=""
ERP_TENANT_ID=""
# Seconds. Catalog can be stale; credit exposure cannot.
ERP_CATALOG_CACHE_TTL="900"
ERP_CREDIT_CACHE_TTL="30"

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
