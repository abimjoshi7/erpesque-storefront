# Non-secret settings for the production build on Cloudflare. NEXT_PUBLIC_*
# values are inlined at build time, so they have to live here rather than in
# Worker vars. Secrets are Worker secrets, never files:
#   npx wrangler secret put ERP_CLIENT_API_KEY
NEXT_PUBLIC_SITE_URL=https://shop.ghumtibags.com
ERP_API_URL=https://api.ghumtibags.com

# Cloudflare Turnstile site key (public). Required: the deploy script and the
# server both refuse to run without it. Pairs with the ERP's TURNSTILE_SECRET_KEY.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
